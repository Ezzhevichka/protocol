{
  "name": "protocol-squad",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.25.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @protocol/backend --filter @protocol/frontend dev",
    "dev:backend": "pnpm --filter @protocol/backend dev",
    "dev:frontend": "pnpm --filter @protocol/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "infra:dev": "docker compose --env-file .env.dev -f docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env.dev -f docker-compose.infra.yml down",
    "infra:reset": "docker compose --env-file .env.dev -f docker-compose.infra.yml down -v",
    "bots:compose:dev": "node tools/generate-bot-compose.mjs --config config/bots.json --env .env.dev --out docker-compose.bots.generated.yml",
    "bots:compose:prod": "node tools/generate-bot-compose.mjs --config config/bots.json --env .env.prod --out docker-compose.bots.generated.yml",
    "bots:dev": "pnpm bots:compose:dev && docker compose --env-file .env.dev -f docker-compose.infra.yml -f docker-compose.bots.generated.yml up -d --build",
    "bots:prod": "pnpm bots:compose:prod && docker compose --env-file .env.prod -f docker-compose.bots.generated.yml up -d --build",
    "bots:down:dev": "docker compose --env-file .env.dev -f docker-compose.bots.generated.yml down",
    "bots:down:prod": "docker compose --env-file .env.prod -f docker-compose.bots.generated.yml down",
    "db:generate": "pnpm --filter @protocol/database db:generate",
    "db:migrate:dev": "pnpm --filter @protocol/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @protocol/database db:migrate:deploy",
    "db:studio": "pnpm --filter @protocol/database db:studio",
	"check:commit": "pnpm lint && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1"
  }
}
