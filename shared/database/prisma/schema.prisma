generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum SquadPermissions {
  startvote
  changemap
  pause
  cheat
  private
  balance
  chat
  kick
  ban
  config
  cameraman
  manageserver
  featuretest
  reserve
  demos
  clientdemos
  debug
  teamchange
  forceteamchange
  canseeadminchat
}

enum SitePermissions {
  ban
  kick
}

enum PunishmentType {
  BAN
  WARN
}

enum StatusType {
  ACTIVE
  EXPIRED
  REVOKED
}

model Role {
  id               String             @id @default(uuid())
  name             String             @unique
  createdAt        DateTime           @default(now()) @map("created_at")
  squadPermissions SquadPermissions[] @map("squad_permissions")
  sitePermissions  SitePermissions[]  @map("site_permissions")

  @@map("roles")
}

model User {
  id         String   @id @default(uuid())
  steamId    String   @unique @map("steam_id")
  name       String
  avatarUrl  String
  profileUrl String?
  createdAt  DateTime @default(now()) @map("created_at")
  roleId     String?  @map("role_id")

  @@map("users")
}

model Punishment {
  id          String         @id @default(uuid())
  type        PunishmentType @map("punishment_type")
  createdAt   DateTime       @default(now()) @map("created_at")
  until       DateTime?      @map("issued_until")
  description String?        @map("description")
  reason      String         @map("reason")
  author      String         @map("author")
  victim      String         @map("victim")
  status      StatusType     @default(ACTIVE) @map("status")

  @@map("punishments")
}
