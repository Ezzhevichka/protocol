generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum SquadPermissions {
  startvote
  changemap
  pause
  cheat
  private
  balance
  chat
  kick
  ban
  config
  cameraman
  manageserver
  featuretest
  reserve
  demos
  clientdemos
  debug
  teamchange
  forceteamchange
  canseeadminchat
}

enum SitePermissions {
  punish
  perm
  kick
}

enum PunishmentType {
  BAN
  WARN
}

enum RoleType {
  ADMIN
  TECH_ADMIN
  SENIOR_MODERATOR
  MODERATOR
  INTERN
  CAMERA
  VIP
}

enum StatusType {
  ACTIVE
  EXPIRED
  REVOKED
}

model Role {
  id               String             @id @default(uuid())
  label            String             @unique
  type             RoleType           @map("type")
  color            String?            @map("color")
  createdAt        DateTime           @default(now()) @map("created_at")
  squadPermissions SquadPermissions[] @map("squad_permissions")
  sitePermissions  SitePermissions[]  @map("site_permissions")

  @@map("Roles")
}

model User {
  id         String   @id @default(uuid())
  steamId    String   @unique @map("steam_id")
  discord    String?  @unique
  name       String
  avatarUrl  String
  profileUrl String?
  createdAt  DateTime @default(now()) @map("created_at")
  roleId     String?  @map("role_id")

  @@map("Users")
}

model Punishment {
  id          String         @id @default(uuid())
  type        PunishmentType @map("punishment_type")
  createdAt   DateTime       @default(now()) @map("created_at")
  until       DateTime?      @map("issued_until")
  updatedAt   DateTime?
  description String?        @map("description")
  reason      String         @map("reason")
  author      String         @map("author")
  victim      String         @map("victim")
  status      StatusType     @default(ACTIVE) @map("status")

  @@map("Punishments")
}

model Rule {
  id              String  @id @default(uuid())
  name            String  @unique
  description     String?
  publicName      String
  warnDescription String?
  duration        String?

  @@map("Rules")
}

model Nickname {
  id       String  @id @default(uuid())
  nickname String
  steamId  String  @unique
  banned   Boolean
  createdAt DateTime

  @@map("Nicknames")
}

model Player {
  id          String    @id @default(uuid())
  nickname    String
  steamId     String    @unique
  eosId       String    @unique
  playedHours String?
  ip          String?
  createdAt   DateTime
  updatedAt   DateTime?
  lastLogin   DateTime

  @@map("Players")
}

enum EventType {
	PLAYER_WOUNDED
	PLAYER_DIED
	PLAYER_CONNECTED
	PLAYER_DISCONNECTED
	ROUND_ENDED
	NEW_GAME
	SERVER_TICK_RATE
	PLAYER_POSSESS_CAMERA
	PLAYER_UNPOSSESS_CAMERA
	ADMIN_BROADCAST
	FORCED_TEAM_CHANGE
	CHAT_MESSAGE
}

model Event {
	id String @id @default(uuid())
	createdAt DateTime
	event String
}