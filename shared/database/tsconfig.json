{
	"extends": "../../tsconfig.node.build.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"declaration": true,
		"sourceMap": false,
		"removeComments": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*.ts", "../../global.d.ts"],
	"exclude": ["node_modules", "dist"]
}
