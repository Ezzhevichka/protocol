{
  "name": "@protocol/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --ignoreDeprecations 6.0 && tsc-alias -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --ignoreDeprecations 6.0",
    "lint": "eslint ."
  },
  "dependencies": {
	"@protocol/database": "workspace:*",
    "@protocol/redis": "workspace:*",
	"@protocol/types": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
