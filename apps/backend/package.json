    "@protocol/redis": "workspace:*",
    "@protocol/types": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "passport": "^0.7.0",
    "passport-steam": "^1.0.18"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/passport": "^1.0.17",
    "axios": "^1.18.1",
