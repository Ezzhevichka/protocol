{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "CommonJS",
		"moduleResolution": "Node",
		"ignoreDeprecations": "6.0",
		"declaration": false,
		"sourceMap": true,
		"types": ["node"],
	},
	"include": ["global.d.ts"],
	"exclude": ["node_modules", "dist"]
}
